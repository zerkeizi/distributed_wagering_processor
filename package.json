{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "smoke": "bun scripts/smoke/index.ts",
    "smoke:infra": "bun scripts/smoke/index.ts infra",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down -v",
    "smoke:domain": "bun scripts/smoke/index.ts domain",
    "migration:up": "bun src/cli/migrate.ts up",
    "migration:down": "bun src/cli/migrate.ts down",
    "migration:status": "bun src/cli/migrate.ts status",
    "smoke:db": "bun scripts/smoke/index.ts db",
    "smoke:race": "bun scripts/smoke/index.ts race",
    "smoke:sqs": "bun scripts/smoke/index.ts sqs",
    "smoke:events": "bun scripts/smoke/index.ts events"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1171.0",
    "@mikro-orm/core": "^7.2.10",
    "@mikro-orm/migrations": "^7.2.10",
    "@mikro-orm/postgresql": "^7.2.10",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
